{
  // Tests, bench, e2e and config files run in Node.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "bench",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
